    <query id="1">
        <name>Highest-Rated Movies by Budget</name>
        <description>Identify movies that achieved the highest average rating relative to their budgets to determine which movies received high ratings having relatively small budgets.</description>
        <parameters>
            <parameter name="fake optional parameter 1" type="STRING" optional="true"/>
            <parameter name="fake required parameter2" type="INTEGER" optional="false"/>
        </parameters>
        <sql>
            SELECT
                m.movie_id,
                m.title,
                m.budget,
                mr.avg_rating,
                (mr.avg_rating / m.budget) AS rating_budget_ration
            FROM movie m
            JOIN (
                SELECT
                movie_id,
                AVG(rating) AS avg_rating
                FROM ratings
                GROUP BY movie_id
            ) mr -- movie_rating
                ON mr.movie_id = m.movie_id
            ;
        </sql>
    </query>
</queries>